<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="MockQueryable.NSubstitute" Version="10.0.12" />
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
        <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
        <PackageReference Include="NSubstitute" Version="6.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Teisti.Application\Teisti.Application.csproj" />
    </ItemGroup>

</Project>
